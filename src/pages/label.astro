---
import BaseLayout from "../layouts/BaseLayout.astro";

// Métadonnées institutionnelles et SEO
const pageTitle = "Le Label & La Charte Éthique | Héritage Vodun";
const description =
  "Découvrez la Charte d'Éthique et de Transmission Héritage Vodun. La référence nationale garantissant la fidélité historique, la dignité du sacré et la qualité des rencontres culturelles au Bénin.";
---

<BaseLayout titrePage={pageTitle} description={description}>
  <div class="min-h-screen bg-dark-bg pb-28 overflow-x-hidden">
    {/* --- HERO SECTION : LE SCEAU & LA CHARTE --- */}
    <section
      class="relative text-center pt-24 pb-20 px-6 bg-[radial-gradient(ellipse_at_top,#1a1a1a_0%,#050505_100%)] opacity-0 animate-fade-down"
    >
      {/* Emblème officiel Héritage Vodun */}
      <div class="flex justify-center items-center mb-12">
        <div
          class="flex flex-col items-center w-28 md:w-36 group transition-transform duration-500 hover:-translate-y-2"
          title="Sceau Officiel — Héritage Vodun"
        >
          <svg
            viewBox="0 0 100 100"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-auto drop-shadow-[0_12px_20px_rgba(212,175,55,0.25)]"
          >
            <defs>
              <linearGradient
                id="bronzeStem"
                x1="47"
                y1="0"
                x2="53"
                y2="0"
                gradientUnits="userSpaceOnUse"
              >
                <stop offset="0%" stop-color="#8B4513"></stop>
                <stop offset="40%" stop-color="#E68A5C"></stop>
                <stop offset="60%" stop-color="#CD853F"></stop>
                <stop offset="100%" stop-color="#5D4037"></stop>
              </linearGradient>
              <linearGradient
                id="bronzeBase"
                x1="50"
                y1="85"
                x2="50"
                y2="92"
                gradientUnits="userSpaceOnUse"
              >
                <stop offset="0%" stop-color="#D2691E"></stop>
                <stop offset="100%" stop-color="#8B4513"></stop>
              </linearGradient>
              <radialGradient id="beadGrad" cx="50%" cy="40%" r="50%">
                <stop offset="0%" stop-color="#F4A460"></stop>
                <stop offset="100%" stop-color="#8B4513"></stop>
              </radialGradient>
            </defs>
            <circle
              cx="50"
              cy="50"
              r="45"
              fill="none"
              stroke="#C06C3B"
              stroke-width="0.6"
              opacity="0.5"
              stroke-dasharray="2 2"></circle>
            <circle
              cx="50"
              cy="50"
              r="42"
              fill="none"
              stroke="#C06C3B"
              stroke-width="0.25"
              opacity="0.3"></circle>
            <path
              d="M42 85 L58 85 L54 92 L46 92 Z"
              fill="url(#bronzeBase)"
              stroke="#5D4037"
              stroke-width="0.5"></path>
            <rect x="47" y="38" width="6" height="47" fill="url(#bronzeStem)"
            ></rect>
            <rect x="47" y="38" width="6" height="2" fill="#000" opacity="0.3"
            ></rect>
            <circle
              cx="50"
              cy="25"
              r="12"
              fill="none"
              stroke="url(#bronzeStem)"
              stroke-width="4"></circle>
            <circle
              cx="50"
              cy="25"
              r="13.5"
              fill="none"
              stroke="#5D4037"
              stroke-width="0.2"
              opacity="0.8"></circle>
            <circle
              cx="50"
              cy="25"
              r="10.5"
              fill="none"
              stroke="#5D4037"
              stroke-width="0.2"
              opacity="0.8"></circle>
            <line
              x1="50"
              y1="13"
              x2="50"
              y2="37"
              stroke="#8B4513"
              stroke-width="0.8"></line>
            <line
              x1="38"
              y1="25"
              x2="62"
              y2="25"
              stroke="#8B4513"
              stroke-width="0.8"></line>
            <circle
              cx="50"
              cy="25"
              r="3.5"
              fill="url(#beadGrad)"
              stroke="#5D4037"
              stroke-width="0.2"></circle>
            <circle cx="50" cy="11" r="2.8" fill="url(#beadGrad)"></circle>
            <circle cx="50" cy="39" r="2.8" fill="url(#beadGrad)"></circle>
            <circle cx="36" cy="25" r="2.8" fill="url(#beadGrad)"></circle>
            <circle cx="64" cy="25" r="2.8" fill="url(#beadGrad)"></circle>
          </svg>
          <span
            class="font-serif text-xs text-gold uppercase tracking-[0.28em] mt-4 font-bold opacity-90 group-hover:opacity-100 transition-opacity"
          >
            HOUN HO
          </span>
        </div>
      </div>

      <p
        class="font-sans text-xs md:text-sm uppercase tracking-[0.25em] text-gold/80 mb-4 font-semibold"
      >
        Charte d&apos;Éthique &amp; de Transmission
      </p>

      <h1 class="font-serif text-4xl md:text-6xl text-white mb-6 leading-tight">
        Le Label <span
          class="font-bold italic bg-gradient-to-r from-white to-gold bg-clip-text text-transparent"
          >Héritage Vodun</span
        >
      </h1>

      <div class="w-16 h-1 bg-gold mx-auto mb-8 rounded-full"></div>

      <p
        class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed font-sans"
      >
        Face à la folklorisation du sacré et aux récits approximatifs, nous
        établissons une référence d&apos;exigence aux quatre coins du Bénin. Une
        garantie d&apos;intégrité pour quiconque souhaite saisir l&apos;ingéniosité du
        Vodun, et une distinction pour ceux qui transmettent ce patrimoine avec
        dignité.
      </p>
    </section>

    {/* --- LES TROIS FONDEMENTS DE LA CHARTE --- */}
    <section class="max-w-6xl mx-auto px-6 py-16">
      <div class="text-center mb-14 opacity-0 animate-fade-up" style="animation-delay: 150ms;">
        <span class="font-sans text-xs uppercase tracking-[0.2em] text-gold/75 block mb-2">
          Les Engagements Fondamentaux
        </span>
        <h2 class="font-serif text-3xl md:text-4xl text-white">
          Trois Piliers d&apos;Exigence
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {/* Pilier 1 */}
        <article
          class="bg-dark-surface/90 p-10 rounded-2xl border border-white/5 border-t-2 border-t-gold shadow-xl hover:-translate-y-1.5 transition-all duration-300 opacity-0 animate-fade-up"
          style="animation-delay: 250ms;"
        >
          <div class="w-12 h-12 rounded-full bg-gold/10 border border-gold/30 flex items-center justify-center mb-6 text-gold">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              <line x1="8" y1="7" x2="16" y2="7"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </div>
          <span class="font-serif text-xs uppercase tracking-[0.2em] text-gold/80 block mb-2">
            Pilier I
          </span>
          <h3 class="font-serif text-2xl text-white mb-4">
            Fidélité au Savoir
          </h3>
          <p class="text-gray-400 leading-relaxed text-sm md:text-base">
            Fini les fables inventées pour séduire le visiteur de passage. Chaque
            intervenant accrédité s&apos;engage à transmettre une mémoire rigoureuse,
            validée auprès des anciens, des dignitaires et des historiens, en
            éclairant la profondeur du Fâ et de l&apos;éthique du vivant.
          </p>
        </article>

        {/* Pilier 2 */}
        <article
          class="bg-dark-surface/90 p-10 rounded-2xl border border-white/5 border-t-2 border-t-gold shadow-xl hover:-translate-y-1.5 transition-all duration-300 opacity-0 animate-fade-up"
          style="animation-delay: 400ms;"
        >
          <div class="w-12 h-12 rounded-full bg-gold/10 border border-gold/30 flex items-center justify-center mb-6 text-gold">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="9"></circle>
              <circle cx="12" cy="12" r="3"></circle>
              <line x1="12" y1="3" x2="12" y2="6"></line>
              <line x1="12" y1="18" x2="12" y2="21"></line>
            </svg>
          </div>
          <span class="font-serif text-xs uppercase tracking-[0.2em] text-gold/80 block mb-2">
            Pilier II
          </span>
          <h3 class="font-serif text-2xl text-white mb-4">
            Dignité du Sacré
          </h3>
          <p class="text-gray-400 leading-relaxed text-sm md:text-base">
            Le Vodun n&apos;est ni un spectacle ni un divertissement. Nos
            collaborateurs veillent au respect absolu des gardiens de nos
            traditions, de l&apos;intimité des sanctuaires et de ce qui relève du
            secret initiatique. Aucune mise en scène artificielle.
          </p>
        </article>

        {/* Pilier 3 */}
        <article
          class="bg-dark-surface/90 p-10 rounded-2xl border border-white/5 border-t-2 border-t-gold shadow-xl hover:-translate-y-1.5 transition-all duration-300 opacity-0 animate-fade-up"
          style="animation-delay: 550ms;"
        >
          <div class="w-12 h-12 rounded-full bg-gold/10 border border-gold/30 flex items-center justify-center mb-6 text-gold">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <span class="font-serif text-xs uppercase tracking-[0.2em] text-gold/80 block mb-2">
            Pilier III
          </span>
          <h3 class="font-serif text-2xl text-white mb-4">
            Justesse &amp; Sérénité
          </h3>
          <p class="text-gray-400 leading-relaxed text-sm md:text-base">
            La confiance naît de la clarté et de l&apos;enracinement. Le Label
            garantit des rencontres encadrées, des engagements transparents
            énoncés à l&apos;avance et des intervenants légitimes au sein même de leurs
            communautés.
          </p>
        </article>
      </div>
    </section>

    {/* --- DOUBLE VOCATION : GARDIENS & VISITEURS --- */}
    <section
      class="max-w-6xl mx-auto px-6 py-12 opacity-0 animate-fade-up"
      style="animation-delay: 650ms;"
    >
      <div class="text-center mb-12">
        <span class="font-sans text-xs uppercase tracking-[0.2em] text-gold/75 block mb-2">
          Une Alliance Équilibrée
        </span>
        <h2 class="font-serif text-3xl md:text-4xl text-white">
          Une Double Garantie sur le Terrain
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Bloc 1 : Gardiens & Acteurs Culturels */}
        <div class="bg-dark-surface/60 border border-gold/25 rounded-2xl p-8 md:p-10">
          <p class="font-sans text-xs uppercase tracking-[0.2em] text-gold font-semibold mb-3">
            Pour les Gardiens &amp; Passeurs de Mémoire
          </p>
          <h3 class="font-serif text-2xl text-white mb-4">
            Honorer l&apos;Intégrité et le Savoir-Faire
          </h3>
          <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6">
            Le Label constitue un signe de reconnaissance pour les gardiens de
            traditions, guides et acteurs (trices) culturels (elles) qui maintiennent la tradition vivante et
            défendent la vérité de notre patrimoine.
          </p>
          <ul class="space-y-3 text-sm text-gray-400">
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">&#9670;</span>
              <span>Distinguer leur sérieux des pratiques opportunistes ou folkloriques.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">&#9670;</span>
              <span>Fédérer les acteurs (trices) légitimes de terroir en terroir autour d&apos;un standard d&apos;excellence.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">&#9670;</span>
              <span>Préserver la dignité des lieux et la justesse de la parole transmise.</span>
            </li>
          </ul>
        </div>

        {/* Bloc 2 : Visiteurs, Chercheurs & Partenaires */}
        <div class="bg-dark-surface/60 border border-gold/25 rounded-2xl p-8 md:p-10">
          <p class="font-sans text-xs uppercase tracking-[0.2em] text-gold font-semibold mb-3">
            Pour les Visiteurs, Chercheurs &amp; Esprits Attentifs
          </p>
          <h3 class="font-serif text-2xl text-white mb-4">
            Offrir un Repère de Confiance Absolu
          </h3>
          <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6">
            Pour quiconque aborde le Bénin avec bon sens et désir de comprendre,
            le Label assure une rencontre directe avec l&apos;ingéniosité de la
            culture africaine.
          </p>
          <ul class="space-y-3 text-sm text-gray-400">
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">&#9670;</span>
              <span>Accéder à une lecture fidèle, philosophique et structurée du Vodun.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">&#9670;</span>
              <span>Évoluer dans un cadre apaisé, transparent et respectueux des usages locaux.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-gold mt-0.5">&#9670;</span>
              <span>Vivre une immersion authentique, loin des mises en scène artificielles.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* --- MANIFESTE INSTITUTIONNEL --- */}
    <section
      class="max-w-4xl mx-auto px-6 mt-6 mb-24 opacity-0 animate-fade-up"
      style="animation-delay: 850ms;"
    >
      <div
        class="bg-dark-surface/60 border border-gold/30 p-10 md:p-16 rounded-2xl relative overflow-hidden backdrop-blur-md"
      >
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-gold/10 rounded-full blur-[80px] pointer-events-none"
        >
        </div>

        <div class="relative z-10 text-center">
          <span class="font-sans text-xs uppercase tracking-[0.25em] text-gold/80 block mb-3">
            Notre Engagement
          </span>
          <div
            class="text-base md:text-lg text-gray-300 leading-relaxed space-y-6 max-w-2xl mx-auto text-left md:text-center"
          >
            <p>
              <strong class="text-gold">Héritage Vodun</strong> agit en harmonie
              avec les institutions nationales, les autorités coutumières et les
              forces vives de nos terroirs. Notre vocation est de structurer et
              d&apos;élever la transmission culturelle sur l&apos;ensemble du territoire
              béninois, afin d&apos;en faire un levier durable de dignité, de
              cohésion et de rayonnement.
            </p>
            <p>
              Nous ouvrons les portes de cette sagesse à toute personne animée
              par le bon sens et le respect.
            </p>
          </div>

          <div
            class="mt-12 pt-8 border-t border-gold/20 flex flex-col items-end max-w-2xl mx-auto text-right"
          >
            <span class="font-serif italic text-2xl text-gold">
              La Direction Héritage Vodun
            </span>
          </div>
        </div>
      </div>
    </section>

    {/* --- CTA --- */}
    <section
      class="text-center px-6 opacity-0 animate-fade-up"
      style="animation-delay: 950ms;"
    >
      <h2 class="font-serif text-3xl md:text-4xl text-white mb-4">
        Vous êtes Gardien (enne) de Tradition, Guide ou acteurs (trices) culturels (elles) ?
      </h2>
      <p class="font-sans text-gray-400 max-w-xl mx-auto mb-8 leading-relaxed">
        Rejoignez un réseau engagé pour la vérité historique et la transmission
        digne de notre patrimoine aux quatre coins du Bénin.
      </p>
      <a
        href="/contact"
        class="inline-block bg-gold hover:bg-gold-hover text-black font-bold uppercase tracking-widest text-sm px-10 py-4 rounded-full transition-all duration-300 hover:shadow-[0_0_25px_rgba(212,175,55,0.4)] hover:-translate-y-1"
      >
        Rejoindre la Charte &rarr;
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  @keyframes fadeDown {
    from {
      opacity: 0;
      transform: translateY(-24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-down {
    animation: fadeDown 0.9s ease-out forwards;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-up {
    animation: fadeUp 0.8s ease-out forwards;
  }
</style>