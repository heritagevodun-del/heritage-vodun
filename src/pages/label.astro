---
import BaseLayout from "../layouts/BaseLayout.astro";

// Métadonnées institutionnelles et SEO
const pageTitle = "Label Qualité & Charte Éthique | Héritage Vodun";
const description =
  "Découvrez la Charte de Confiance Héritage Vodun. La référence nationale garantissant l'authenticité historique, le respect du sacré et la qualité de l'accueil culturel aux quatre coins du Bénin.";
---

<BaseLayout titrePage={pageTitle} description={description}>
  <div class="min-h-screen bg-dark-bg pb-24 overflow-x-hidden">
    {/* --- HERO SECTION : SCEAU INSTITUTIONNEL --- */}
    <section
      class="relative text-center pt-24 pb-20 px-6 bg-[radial-gradient(ellipse_at_top,#1a1a1a_0%,#050505_100%)] opacity-0 animate-fade-down"
    >
      {/* Emblème officiel Héritage Vodun */}
      <div class="flex justify-center items-center mb-12">
        <div
          class="flex flex-col items-center w-28 md:w-36 group transition-transform duration-500 hover:-translate-y-2"
          title="Sceau Officiel — Héritage Vodun"
        >
          <svg
            viewBox="0 0 100 100"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-auto drop-shadow-[0_12px_20px_rgba(212,175,55,0.25)]"
          >
            <defs>
              <linearGradient
                id="bronzeStem"
                x1="47"
                y1="0"
                x2="53"
                y2="0"
                gradientUnits="userSpaceOnUse"
              >
                <stop offset="0%" stop-color="#8B4513"></stop>
                <stop offset="40%" stop-color="#E68A5C"></stop>
                <stop offset="60%" stop-color="#CD853F"></stop>
                <stop offset="100%" stop-color="#5D4037"></stop>
              </linearGradient>
              <linearGradient
                id="bronzeBase"
                x1="50"
                y1="85"
                x2="50"
                y2="92"
                gradientUnits="userSpaceOnUse"
              >
                <stop offset="0%" stop-color="#D2691E"></stop>
                <stop offset="100%" stop-color="#8B4513"></stop>
              </linearGradient>
              <radialGradient id="beadGrad" cx="50%" cy="40%" r="50%">
                <stop offset="0%" stop-color="#F4A460"></stop>
                <stop offset="100%" stop-color="#8B4513"></stop>
              </radialGradient>
            </defs>
            <circle
              cx="50"
              cy="50"
              r="45"
              fill="none"
              stroke="#C06C3B"
              stroke-width="0.6"
              opacity="0.5"
              stroke-dasharray="2 2"></circle>
            <circle
              cx="50"
              cy="50"
              r="42"
              fill="none"
              stroke="#C06C3B"
              stroke-width="0.25"
              opacity="0.3"></circle>
            <path
              d="M42 85 L58 85 L54 92 L46 92 Z"
              fill="url(#bronzeBase)"
              stroke="#5D4037"
              stroke-width="0.5"></path>
            <rect x="47" y="38" width="6" height="47" fill="url(#bronzeStem)"
            ></rect>
            <rect x="47" y="38" width="6" height="2" fill="#000" opacity="0.3"
            ></rect>
            <circle
              cx="50"
              cy="25"
              r="12"
              fill="none"
              stroke="url(#bronzeStem)"
              stroke-width="4"></circle>
            <circle
              cx="50"
              cy="25"
              r="13.5"
              fill="none"
              stroke="#5D4037"
              stroke-width="0.2"
              opacity="0.8"></circle>
            <circle
              cx="50"
              cy="25"
              r="10.5"
              fill="none"
              stroke="#5D4037"
              stroke-width="0.2"
              opacity="0.8"></circle>
            <line
              x1="50"
              y1="13"
              x2="50"
              y2="37"
              stroke="#8B4513"
              stroke-width="0.8"></line>
            <line
              x1="38"
              y1="25"
              x2="62"
              y2="25"
              stroke="#8B4513"
              stroke-width="0.8"></line>
            <circle
              cx="50"
              cy="25"
              r="3.5"
              fill="url(#beadGrad)"
              stroke="#5D4037"
              stroke-width="0.2"></circle>
            <circle cx="50" cy="11" r="2.8" fill="url(#beadGrad)"></circle>
            <circle cx="50" cy="39" r="2.8" fill="url(#beadGrad)"></circle>
            <circle cx="36" cy="25" r="2.8" fill="url(#beadGrad)"></circle>
            <circle cx="64" cy="25" r="2.8" fill="url(#beadGrad)"></circle>
          </svg>
          <span
            class="font-serif text-xs text-gold uppercase tracking-[0.25em] mt-4 font-bold opacity-90 group-hover:opacity-100 transition-opacity"
          >
            Sceau d'Excellence
          </span>
        </div>
      </div>

      <p
        class="font-sans text-xs md:text-sm uppercase tracking-[0.25em] text-gold/80 mb-4 font-semibold"
      >
        Charte Nationale d'Éthique & de Transmission
      </p>

      <h1 class="font-serif text-4xl md:text-6xl text-white mb-6 leading-tight">
        Le Label <span
          class="font-bold italic bg-gradient-to-r from-white to-gold bg-clip-text text-transparent"
          >Héritage Vodun</span
        >
      </h1>

      <div class="w-16 h-1 bg-gold mx-auto mb-8 rounded-full"></div>

      <p
        class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed font-sans"
      >
        Face à la folklorisation du sacré et aux récits approximatifs, nous
        établissons une référence d'exigence aux quatre coins du Bénin. Une
        garantie d'intégrité pour quiconque souhaite comprendre l'ingéniosité du
        Vodun, et une reconnaissance pour les gardiens qui transmettent ce
        patrimoine avec dignité.
      </p>
    </section>

    {/* --- LES 3 PILIERS DU LABEL --- */}
    <section
      class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-3 gap-10"
    >
      <div
        class="bg-dark-surface p-10 rounded-xl border-t-4 border-gold shadow-xl hover:-translate-y-2 transition-all duration-300 opacity-0 animate-fade-up"
        style="animation-delay: 200ms;"
      >
        <div class="text-4xl mb-6">📜</div>
        <h3 class="font-serif text-2xl text-white mb-4">
          1. Fidélité Historique & Savoir
        </h3>
        <p class="text-gray-400 leading-relaxed text-sm md:text-base">
          Fini les fables inventées pour séduire de passage. Chaque acteur
          accrédité s'engage à transmettre une mémoire rigoureuse, validée
          auprès des anciens, des dignitaires et des historiens, en éclairant la
          philosophie profonde du Fâ et du vivant.
        </p>
      </div>

      <div
        class="bg-dark-surface p-10 rounded-xl border-t-4 border-gold shadow-xl hover:-translate-y-2 transition-all duration-300 opacity-0 animate-fade-up"
        style="animation-delay: 400ms;"
      >
        <div class="text-4xl mb-6">🤝</div>
        <h3 class="font-serif text-2xl text-white mb-4">
          2. Dignité & Respect du Sacré
        </h3>
        <p class="text-gray-400 leading-relaxed text-sm md:text-base">
          Le Vodun n'est ni un spectacle ni un divertissement. Nos collaborateurs
          veillent au respect absolu des gardiens de nos traditions et des lieux. Aucune mise en scène artificielle, aucune
          dénaturation des traditions.
        </p>
      </div>

      <div
        class="bg-dark-surface p-10 rounded-xl border-t-4 border-gold shadow-xl hover:-translate-y-2 transition-all duration-300 opacity-0 animate-fade-up"
        style="animation-delay: 600ms;"
      >
        <div class="text-4xl mb-6">🛡️</div>
        <h3 class="font-serif text-2xl text-white mb-4">
          3. Sérénité & Ancrage Local
        </h3>
        <p class="text-gray-400 leading-relaxed text-sm md:text-base">
          La confiance naît de la clarté et de l'enracinement. Le Label garantit
          des rencontres encadrées, des engagements transparents annoncés à
          l'avance et des intervenants reconnus au sein même de leurs
          communautés.
        </p>
      </div>
    </section>

    {/* --- PARCOURS D'ACCRÉDITATION SUR LE TERRAIN --- */}
    <section
      class="max-w-5xl mx-auto px-6 py-12 mb-12 opacity-0 animate-fade-up"
      style="animation-delay: 700ms;"
    >
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl md:text-4xl text-white mb-4">
          Une Démarche Ancrée dans le Réel
        </h2>
        <p class="text-gray-400 max-w-2xl mx-auto text-base">
          L'attribution du Label repose exclusivement sur la rencontre humaine,
          la vérification sur place et le respect mutuel.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="border border-white/10 bg-dark-surface/40 p-8 rounded-xl">
          <span class="font-serif text-gold text-sm uppercase tracking-widest block mb-2">
            Étape I
          </span>
          <h3 class="font-serif text-xl text-white mb-3">
            Rencontre & Échange
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Dialogue direct sur le terrain avec les guides, responsables de
            sites et acteurs culturels afin d'évaluer la justesse de leur
            transmission.
          </p>
        </div>

        <div class="border border-white/10 bg-dark-surface/40 p-8 rounded-xl">
          <span class="font-serif text-gold text-sm uppercase tracking-widest block mb-2">
            Étape II
          </span>
          <h3 class="font-serif text-xl text-white mb-3">
            Adhésion à la Charte
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Engagement solennel à honorer nos trois piliers d'éthique, de
            transparence et de préservation de l'intégrité culturelle.
          </p>
        </div>

        <div class="border border-white/10 bg-dark-surface/40 p-8 rounded-xl">
          <span class="font-serif text-gold text-sm uppercase tracking-widest block mb-2">
            Étape III
          </span>
          <h3 class="font-serif text-xl text-white mb-3">
            Accréditation & Suivi
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Intégration au réseau national Héritage Vodun et accompagnement
            continu pour offrir aux visiteurs une immersion authentique et
            apaisée.
          </p>
        </div>
      </div>
    </section>

    {/* --- MANIFESTE INSTITUTIONNEL --- */}
    <section
      class="max-w-4xl mx-auto px-6 mb-24 opacity-0 animate-fade-up"
      style="animation-delay: 850ms;"
    >
      <div
        class="bg-dark-surface/50 border border-gold/30 p-10 md:p-16 rounded-2xl relative overflow-hidden backdrop-blur-md"
      >
        {/* Lueur décorative */}
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-gold/10 rounded-full blur-[80px] pointer-events-none"
        >
        </div>

        <div class="relative z-10 text-center">
          <h2 class="font-serif text-3xl md:text-4xl text-white mb-8">
            Notre Engagement au Service du Bénin
          </h2>
          <div
            class="text-lg text-gray-300 leading-relaxed space-y-6 max-w-2xl mx-auto text-left md:text-center"
          >
            <p>
              <strong class="text-gold">Héritage Vodun</strong> agit en harmonie
              avec les institutions nationales, les autorités coutumières et les
              forces vives de nos terroirs. Notre vocation est de structurer et
              d'élever la transmission culturelle sur l'ensemble du territoire
              béninois, afin d'en faire un levier durable de dignité, de
              cohésion et de développement local.
            </p>
            <p>
              Nous ouvrons les portes de cette sagesse à toute personne animée
              par le bon sens et le respect, convaincus que la compréhension
              juste de la culture africaine est une richesse universelle.
            </p>
          </div>

          <div
            class="mt-12 pt-8 border-t border-gold/20 flex flex-col items-end max-w-2xl mx-auto text-right"
          >
            <span class="font-serif italic text-2xl text-gold mb-1">
              La Direction Héritage Vodun
            </span>
            
          </div>
        </div>
      </div>
    </section>

    {/* --- CTA --- */}
    <section
      class="text-center px-6 opacity-0 animate-fade-up"
      style="animation-delay: 1000ms;"
    >
      <h2 class="font-serif text-3xl text-white mb-4">
        Vous êtes Gardien de Tradition, Guide ou Acteur Culturel ?
      </h2>
      <p class="font-sans text-gray-400 max-w-xl mx-auto mb-8">
        Rejoignez un réseau engagé pour la vérité historique et le rayonnement
        authentique de notre patrimoine aux quatre coins du Bénin.
      </p>
      <a
        href="/contact"
        class="inline-block bg-gold hover:bg-gold-hover text-black font-bold uppercase tracking-widest px-10 py-4 rounded-full transition-all duration-300 hover:shadow-[0_0_20px_rgba(212,175,55,0.4)] hover:-translate-y-1"
      >
        Rejoindre la Charte &rarr;
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  @keyframes fadeDown {
    from {
      opacity: 0;
      transform: translateY(-30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-down {
    animation: fadeDown 1s ease-out forwards;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-up {
    animation: fadeUp 0.8s ease-out forwards;
  }
</style>